# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored — never commit real values.

# ---------------------------------------------------------------------------
# Google Apps Script web app that appends enquiry rows to the Google Sheet.
# Read on the SERVER ONLY (src/lib/enquiry.functions.ts). Do NOT prefix these
# with VITE_ — that would ship them to the browser.
# ---------------------------------------------------------------------------
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=

# ---------------------------------------------------------------------------
# Production origin used for canonical URLs, Open Graph URLs, JSON-LD and
# sitemap.xml. Leave blank to use the default in src/lib/seo.ts.
# Never point this at localhost.
# ---------------------------------------------------------------------------
VITE_SITE_URL=
